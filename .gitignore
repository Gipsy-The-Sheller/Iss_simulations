# ---- simulation output ----
# The tables under results/ are the evidence for the paper and are tracked;
# the dense ones are archived gzipped (scripts/s20_pack_results.py).  Everything
# else in there is regenerable scratch.
results/**
!results/**/
!results/**/*.csv
!results/**/*.csv.gz
!results/**/*.json
!results/**/README.md
results/**/trees/
results/**/*.part*.csv
logs/
work/
scratch/
*.fa
*.fasta
*.phy
*.phylip
*.nex
*.treefile
*.contree
*.ckp.gz
*.tar
*.tar.gz

# ---- iqtree / alisim scratch ----
*.iqtree
*.log
!logs/.gitkeep
*.state
*.mldist
*.splits.nex
*.bionj
.alisim*

# ---- python ----
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.env
.venv/
venv/
*.egg-info/
build/
dist/

# ---- latex build artefacts (manuscript.bbl is kept: arXiv wants it) ----
*.aux
*.blg
*.out
*.synctex.gz
latex.out/

# ---- data cache ----
.cache/

# ---- editors / os ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- loose notes in the repository root ----
# Working notes, independent-review reports and proof drafts accumulated in the
# root as the project went on, in several hands and several formats.  They are
# kept on disk and are not part of the paper; the two root files that are
# structure rather than notes are listed back in.
/*.md
!/README.md
!/PLAN.md

# ---- keep these despite the rules above ----
!docs/**
!refs/**
!figures/**
!conf/**

# ---- archives in the repository root ----
# A `git add -A` in the root swept a 4.6 GB alignment and a 570 MB deposit
# archive into a commit once; the histories had to be rewritten to get them
# back out.  Rooted so that the gzipped result tables under results/, which
# are tracked on purpose, are unaffected.
/*.gz
/*.7z
/*.zip
/*.tar
/*.tar.gz

# ---- third-party material, deliberately not redistributed ----
# Other people's alignments, supplementary files and published PDFs.  These are
# needed to reproduce the empirical sections, but they are fetched by the
# scripts (see scripts/s09_fetch_gigadb.py and data/README.txt) rather than
# shipped; the rules are last so that they beat the keep-rules above.
data/
docs/duchene2022_si/
*.pdf
5131558.json
5131558.zip
ref.png
ref2.png
